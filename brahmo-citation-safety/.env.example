# Copy this file to .env and fill in your real values.
# NEVER commit .env — it contains secrets.

# Indian Kanoon API key (free ₹500 credit at api.indiankanoon.org/signup/)
INDIAN_KANOON_API_KEY=your_ik_api_key_here

# LLM API key (any provider — Anthropic, OpenAI, Gemini)
LLM_API_KEY=your_llm_api_key_here

# (Optional) Supabase — only needed if migrating from SQLite to Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
